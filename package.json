{
  "name": "one-life-at-sea",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "dev:players": "node scripts/dev-players.mjs",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "check": "npm run docs:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up --local",
    "db:status": "node scripts/local-status.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "config:check": "node scripts/config/manage.mjs check",
    "config:sync": "node scripts/config/manage.mjs sync",
    "predev": "npm run config:check",
    "prestart": "npm run config:check",
    "prebuild": "npm run config:check",
    "predb:migrate": "npm run config:check",
    "predb:start": "npm run config:check",
    "pretest:db": "npm run config:check",
    "test:config:db": "node scripts/config/test-database.mjs",
    "pretest:config:db": "npm run config:check",
    "pretest:e2e": "npm run config:check",
    "audit:economy": "node scripts/audit-economy.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "lucide-react": "1.46.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "type": "module"
}
